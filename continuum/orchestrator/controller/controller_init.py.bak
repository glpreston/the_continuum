# continuum/orchestrator/controller/controller_init.py

import uuid
from typing import Dict

from sqlalchemy import text

from continuum.db.sqlalchemy_connection import get_db_session
from continuum.core.context import ContinuumContext
from continuum.core.logger import log_debug, log_error, log_info

# Emotional engine (Phase‑5 hybrid)
from continuum.persona.emotional_memory import EmotionalMemory
from continuum.emotion.state_machine import EmotionalState
from continuum.emotion.timeline import EmotionalArcTimeline
from continuum.emotion.transition import EmotionalTransitionEngine
from continuum.emotion.modulation import OutputModulationEngine

# Registry
from continuum.db.registry import ModelRegistry


# ============================================================
# 0. Core controller initialization (DB, emotion, context)
# ============================================================
def initialize_controller_state(controller):
    log_error("🔥 ENTERED controller_init.initialize_controller_state() 🔥", phase="controller")

    # ---------------------------------------------------------
    # 1. Database session
    # ---------------------------------------------------------
    controller.db = get_db_session()

    # ---------------------------------------------------------
    # 2. Emotional engine (Phase‑5 hybrid)
    # ---------------------------------------------------------
    controller.emotional_state = EmotionalState()
    controller.emotional_memory = EmotionalMemory()

    controller.emotion_timeline = EmotionalArcTimeline()
    controller.emotion_transition = EmotionalTransitionEngine(
        controller.emotional_state,
        controller.emotion_timeline,
    )
    controller.emotion_modulation = OutputModulationEngine(controller.emotional_state)

    # Aliases for rewrite pipeline compatibility
    controller.emotion_state = controller.emotional_state
    controller.emotion_memory = controller.emotional_memory

    # ---------------------------------------------------------
    # 3. Model registry (auto-loads nodes/models from DB)
    # ---------------------------------------------------------
    controller.registry = ModelRegistry(controller.db)
    log_debug("[INIT] Model registry initialized", phase="controller")

    # ---------------------------------------------------------
    # 4. Core context
    # ---------------------------------------------------------
    controller.context = ContinuumContext(conversation_id=str(uuid.uuid4()))
    controller.context.emotional_state = controller.emotional_state
    controller.context.emotional_memory = controller.emotional_memory
    controller.context.debug_flags["show_prompts"] = True

    # ---------------------------------------------------------
    # 5. Meta‑Persona rewrite flags
    # ---------------------------------------------------------
    controller.flags = {"enable_meta_llm": False}

    log_debug("[INIT] Controller initialization complete", phase="controller")


# ============================================================
# 1. Rewrite config loader
# ============================================================
def load_rewrite_config(controller):
    try:
        row = controller.db.execute(
            text("SELECT pinned_model FROM rewrite_config LIMIT 1")
        ).fetchone()

        if row and row[0]:
            controller.rewrite_model = row[0]
        else:
            controller.rewrite_model = "qwen2.5:0.5b"

    except Exception as e:
        log_error(f"[REWRITE CONFIG] Failed to load rewrite model: {e}", phase="controller")
        controller.rewrite_model = "qwen2.5:0.5b"


# ============================================================
# 2. Actor defaults + fallbacks
# ============================================================
def load_actor_defaults(controller):
    actor_defaults = {}
    actor_fallbacks = {}

    try:
        rows = controller.db.execute(
            text("SELECT name, default_model, fallback_model FROM actors")
        ).mappings().all()

        for r in rows:
            name = r["name"]
            default_model = r["default_model"]
            fallback_model = r["fallback_model"]

            if default_model:
                actor_defaults[name] = default_model
            if fallback_model:
                actor_fallbacks[name] = fallback_model

        log_info(f"[Actors] Loaded {len(actor_defaults)} actor defaults from DB", phase="controller")

    except Exception as e:
        log_error(f"[Actors] Failed to load actor defaults from DB: {e}", phase="controller")

    controller.actor_defaults = actor_defaults
    controller.actor_fallbacks = actor_fallbacks


# ============================================================
# 3. Actor settings (Senate preferences)
# ============================================================
def load_actor_settings(controller):
    settings = {}

    try:
        # Load all actors
        actor_rows = controller.db.execute(
            text("SELECT name FROM actors")
        ).mappings().all()
        actor_names = [r["name"] for r in actor_rows]

        # Load preferences
        pref_rows = controller.db.execute(
            text("""
                SELECT actor_name, model_name, preference_weight
                FROM actor_model_preferences
            """)
        ).mappings().all()

        prefs_by_actor: Dict[str, list] = {}
        for r in pref_rows:
            actor = r["actor_name"]
            model = r["model_name"]
            weight = r["preference_weight"]
            prefs_by_actor.setdefault(actor, []).append((model, weight))

        # Build settings structure
        for actor in actor_names:
            prefs = prefs_by_actor.get(actor, [])
            preferred_models = [
                m for (m, w) in sorted(prefs, key=lambda x: -x[1])
            ] if prefs else []

            settings[actor] = {
                "preferred_models": preferred_models,
                "enabled": True,
                "weight": 1.0,
            }

        log_info(f"[Actors] Loaded actor_settings for {len(settings)} actors from DB", phase="controller")

    except Exception as e:
        log_error(f"[Actors] Failed to load actor_settings from DB: {e}", phase="controller")
        settings = {}

    controller.actor_settings = settings